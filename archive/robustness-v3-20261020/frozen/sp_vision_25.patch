 namespace tools
 {
+Innovation ExtendedKalmanFilter::innovation(const Eigen::VectorXd &z,
+  const Eigen::MatrixXd &H, const Eigen::MatrixXd &R,
+  std::function<Eigen::VectorXd(const Eigen::VectorXd &)> h,
+  std::function<Eigen::VectorXd(const Eigen::VectorXd &,const Eigen::VectorXd &)> subtract) const
+{
+  Innovation a;
+  a.residual=subtract(z,h(x)); a.covariance=H*P*H.transpose()+R;
+  if(!a.residual.allFinite()||!a.covariance.allFinite()) return a;
+  Eigen::LDLT<Eigen::MatrixXd> factor(a.covariance);
+  if(factor.info()!=Eigen::Success||!factor.isPositive()) return a;
+  a.nis=a.residual.dot(factor.solve(a.residual));
+  a.valid=std::isfinite(a.nis)&&a.nis>=0;
+  return a;
+}
+
+bool ExtendedKalmanFilter::correct(const Eigen::MatrixXd &H,
+  const Eigen::MatrixXd &R,const Innovation &a)
+{
+  if(!a.valid) return false;
+  Eigen::LDLT<Eigen::MatrixXd> factor(a.covariance);
+  if(factor.info()!=Eigen::Success||!factor.isPositive()) return false;
+  Eigen::MatrixXd K=factor.solve(H*P).transpose();
+  Eigen::VectorXd next=x_add(x,K*a.residual);
+  Eigen::MatrixXd A=I-K*H;
+  Eigen::MatrixXd nextP=A*P*A.transpose()+K*R*K.transpose();
+  nextP=(nextP+nextP.transpose()).eval()*.5;
+  if(!next.allFinite()||!nextP.allFinite()) return false;
+  x=next; P=nextP; last_nis=a.nis;
+  data["nis_prior"]=a.nis;
+  data["residual_yaw_prior"]=a.residual[0]; data["residual_pitch_prior"]=a.residual[1];
+  data["residual_distance_prior"]=a.residual[2]; data["residual_angle_prior"]=a.residual[3];
+  return true;
+}
