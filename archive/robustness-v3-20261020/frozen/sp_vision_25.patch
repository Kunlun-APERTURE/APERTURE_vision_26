+    for(int i:{0,1,3}) r[i]=tools::limit_rad(r[i]);
+    return r;
+  };
+  const auto ypd=tools::xyz2ypd(predicted);
+  const Eigen::Vector4d expected(ypd[0],ypd[1],ypd[2],tools::limit_rad(ekf_.x[6]+id*2*CV_PI/armor_num_));
+  a.innovation.residual=subtract(z,expected);
+  a.innovation.covariance=a.R;
+  const auto J=tools::xyz2ypd_jacobian(predicted);
+  const Eigen::Matrix3d position_covariance=plate.initialized?plate.position_covariance():Eigen::Matrix3d::Identity()*.04;
+  a.innovation.covariance.topLeftCorner(3,3)+=J*position_covariance*J.transpose();
+  a.innovation.covariance(3,3)+=ekf_.P(6,6);
+  Eigen::LDLT<Eigen::MatrixXd> factor(a.innovation.covariance);
+  if(factor.info()==Eigen::Success && factor.isPositive() && a.innovation.residual.allFinite()) {
+    a.innovation.nis=a.innovation.residual.dot(factor.solve(a.innovation.residual));
+    a.innovation.valid=std::isfinite(a.innovation.nis)&&a.innovation.nis>=0;
+  }
+  a.quality=a.innovation.valid;
+  // Geometric distance resolves model plate identity when yaw is uncertain.
+  a.cost=a.innovation.nis+a.position_residual.squaredNorm()/.04+(plate.initialized?0.:2.);
+  a.reason=!a.quality ? "nonfinite_innovation" : a.innovation.nis>continuity_.innovation_limit ? "innovation" : "accepted";
+  return a;
+}
