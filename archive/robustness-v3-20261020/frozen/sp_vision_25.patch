+void Target::sync_translation()
+{
+  if(preferred_plate_<0 || !plate_filters_[preferred_plate_].initialized)return;
+  const auto &plate=plate_filters_[preferred_plate_];
+  const double angle=ekf_.x[6]+preferred_plate_*2*CV_PI/armor_num_;
+  const bool alternate=armor_num_==4 && preferred_plate_%2;
+  const double radius=ekf_.x[8]+(alternate?ekf_.x[9]:0);
+  const Eigen::Vector3d center=plate.position()+Eigen::Vector3d(radius*std::cos(angle),radius*std::sin(angle),alternate?-ekf_.x[10]:0);
+  for(int i=0;i<3;++i) {ekf_.x[2*i]=center[i];ekf_.x[2*i+1]=plate.velocity()[i];}
+}
