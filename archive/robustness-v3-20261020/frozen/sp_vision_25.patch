+bool Target::update_robust(const std::vector<std::pair<Armor,int>> &observations)
+{
+  continuity_diagnostics={{"updates",nlohmann::json::array()},
+    {"state_before",std::vector<double>(ekf_.x.data(),ekf_.x.data()+ekf_.x.size())}};
+  bool accepted=false;
+  if(!observations.empty()) {
+    const auto &[armor,id]=observations.front();
+    auto a=assess(armor,id);
+    const double gap=tools::delta_time(t_,evidence_time_);
+    const bool consecutive=id==evidence_id_ && gap>0 && gap<=.075;
+    if(a.quality) {
+      // Bearing change is observed much more reliably than single-frame PnP
+      // depth. Depth noise must not trigger a lateral maneuver or relax every
+      // velocity axis at once.
+      const double bearing=std::atan2(armor.xyz_in_world.y(),armor.xyz_in_world.x());
+      const Eigen::Vector2d lateral(-std::sin(bearing),std::cos(bearing));
+      const Eigen::Vector2d motion_innovation=consecutive ?
+        (lateral*lateral.dot(a.position_residual.head<2>())).eval() : Eigen::Vector2d::Zero();
+      const double lateral_threshold=std::max(.01,continuity_.bearing_noise_rad
+        *armor.xyz_in_world.head<2>().norm()*1.5);
+      const bool position_large=consecutive && motion_innovation.norm()>lateral_threshold;
+      const double dot=motion_innovation.dot(previous_motion_innovation_);
+      const double scale=motion_innovation.norm()*previous_motion_innovation_.norm();
+      translation_evidence_=position_large ? (consecutive && scale>0 && dot/scale>.8 ? translation_evidence_+1 : 1) : 0;
+      const double angle=a.innovation.residual[3];
+      // A persistent orientation offset is not proof of angular acceleration.
+      // Require coherent incremental orientation evidence instead.
+      const double orientation_step=tools::limit_rad(angle-previous_angle_residual_);
+      const bool angular_motion=consecutive && std::abs(orientation_step)>.01 && std::abs(orientation_step)<.15;
+      rotation_evidence_=angular_motion ? (orientation_step*previous_orientation_step_>0 ? rotation_evidence_+1 : 1) : 0;
+      if(translation_evidence_>=3) {
+        if(translation_evidence_==3) {
+          // Relax velocity certainty rather than teleporting position to data.
+          for(auto &plate:plate_filters_)if(plate.initialized) {
+            Eigen::Matrix<double,6,1> direction=Eigen::Matrix<double,6,1>::Zero();
+            direction[1]=lateral.x();direction[3]=lateral.y();
+            const double current=direction.dot(plate.P*direction);
+            plate.P+=std::max(0.,4.-current)*direction*direction.transpose();
+          }
+        }
+        translation_maneuver_=true;
+      }
+      if(rotation_evidence_>=3) {
+        if(rotation_evidence_==3) ekf_.P(7,7)=std::max(ekf_.P(7,7),1.);
+        rotation_maneuver_=true;
+      }
+      if(!position_large && std::abs(angle)<.15 && a.innovation.nis<continuity_.innovation_limit) ++quiet_count_;
+      else quiet_count_=0;
+      if(quiet_count_>=5) { translation_maneuver_=false; rotation_maneuver_=false; }
+      previous_angle_residual_=angle;
+      previous_orientation_step_=orientation_step;
+      previous_motion_innovation_=motion_innovation;
+      evidence_time_=t_; evidence_id_=id;
+    } else { translation_evidence_=0;rotation_evidence_=0; }
+  }
+  for(const auto &[armor,id]:observations) {
+    auto a=assess(armor,id);
+    auto record=nlohmann::json{{"plate_id",id},{"quality",a.quality},{"reason",a.reason},
+      {"reprojection_rms_px",armor.reprojection_rms_px},{"nis_prior",a.innovation.nis},
+      {"position_residual_m",{a.position_residual.x(),a.position_residual.y(),a.position_residual.z()}}};
+    if(a.innovation.valid) record["innovation"]=std::vector<double>(a.innovation.residual.data(),a.innovation.residual.data()+4);
+    if(a.quality && a.innovation.nis<=continuity_.innovation_limit) {
+      const auto before_x=ekf_.x; const auto before_P=ekf_.P;
+      const auto before_plate=plate_filters_[id];
+      bool ok=ekf_.correct(a.H,a.R,a.innovation);
+      if(ok) {
+        const Eigen::Matrix3d inverse=tools::xyz2ypd_jacobian(armor.xyz_in_world).inverse();
+        const Eigen::Matrix3d R=inverse*a.R.topLeftCorner(3,3)*inverse.transpose();
+        ok=plate_filters_[id].update(armor.xyz_in_world,R,std::abs(cv::contourArea(armor.points)));
+      }
+      if(ok && diverged()) {
+        ok=false;record["reason"]="geometry_bounds";
+      }
+      if(!ok) {ekf_.x=before_x;ekf_.P=before_P;plate_filters_[id]=before_plate;}
+      if(ok) {
+        accepted=true; if(id!=0) jumped=true;
+        is_switch_=id!=last_id; if(is_switch_)++switch_count_;
+        last_id=id;++update_count_;
+      }
+      record["accepted"]=ok;
+    } else record["accepted"]=false;
+    continuity_diagnostics["updates"].push_back(record);
+  }
+  int best=-1;double best_area=0;
+  for(int id=0;id<armor_num_;++id)if(plate_filters_[id].initialized && plate_filters_[id].age_s<.05) {
+    double area=plate_filters_[id].area*(id==preferred_plate_?(continuity_.robust_v3?continuity_.preferred_plate_hysteresis:1.15):1.);
+    if(area>best_area) {best=id;best_area=area;}
+  }
+  if(best>=0)preferred_plate_=best;
+  sync_translation();
+  continuity_diagnostics["state_after"]=std::vector<double>(ekf_.x.data(),ekf_.x.data()+ekf_.x.size());
+  continuity_diagnostics["translation_maneuver"]=translation_maneuver_;
+  continuity_diagnostics["rotation_maneuver"]=rotation_maneuver_;
+  continuity_diagnostics["translation_evidence_frames"]=translation_evidence_;
+  continuity_diagnostics["rotation_evidence_frames"]=rotation_evidence_;
+  continuity_diagnostics["translation_model"]="independent_plate_cv";
+  continuity_diagnostics["plates"]=nlohmann::json::array();
+  for(const auto &plate:plate_filters_) {
+    auto row=nlohmann::json{{"initialized",plate.initialized},{"age_s",plate.age_s}};
+    if(plate.initialized) {
+      row["state"]=std::vector<double>(plate.x.data(),plate.x.data()+6);
+      row["covariance_column_major"]=std::vector<double>(plate.P.data(),plate.P.data()+36);
+    }
+    continuity_diagnostics["plates"].push_back(row);
+  }
+  return accepted;
+}
